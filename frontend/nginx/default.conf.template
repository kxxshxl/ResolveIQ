# Rendered by the nginx entrypoint (envsubst). DNS_RESOLVER / BACKEND_URL are set in the Dockerfile and can be overridden
# (Kubernetes: DNS_RESOLVER=kube-dns.kube-system.svc.cluster.local, BACKEND_URL=http://backend:8000).
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'" always;

  # Re-resolve the backend name periodically so scaled replicas (round-robin DNS) all receive traffic.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  set $backend ${BACKEND_URL};

  location /api/ {
    client_max_body_size 1m;
    proxy_pass $backend;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_read_timeout 90s;
  }
  location = /health { proxy_pass $backend; }
  location = /health/ready { proxy_pass $backend; }

  # Prometheus scrapes the backend directly on the internal network; never expose metrics publicly.
  location = /metrics { return 404; }

  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; add_header X-Content-Type-Options "nosniff" always; }
  location / { try_files $uri /index.html; add_header Cache-Control "no-cache"; add_header X-Content-Type-Options "nosniff" always; }
}
