{
 "uid": "resolveiq-overview",
 "title": "ResolveIQ - service overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "resolveiq"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "HTTP requests / s by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (path, status) (rate(resolveiq_http_requests_total[1m]))",
     "legendFormat": "{{path}} {{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "POST /api/v1/resolve latency (p50 / p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(resolveiq_http_request_latency_seconds_bucket{path=\"/api/v1/resolve\"}[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(resolveiq_http_request_latency_seconds_bucket{path=\"/api/v1/resolve\"}[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
