# Copy to .env and change secrets. Never commit .env.
# ---- ports exposed on the host (offset so they do not clash with other local stacks) ----
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8100
FRONTEND_HOST_PORT=5174
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3001

# ---- postgres: owner runs migrations, app role is least-privilege (DML only) ----
POSTGRES_DB=resolveiq
POSTGRES_USER=resolveiq_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=resolveiq_app
APP_DB_PASSWORD=change-me-app

# ---- backend (used when running outside compose; compose overrides hosts) ----
DATABASE_URL=postgresql://resolveiq_app:change-me-app@127.0.0.1:5433/resolveiq
DATABASE_ADMIN_URL=postgresql://resolveiq_owner:change-me-owner@127.0.0.1:5433/resolveiq
REDIS_URL=redis://127.0.0.1:6380/0

# comma separated; empty = auth disabled (dev only, logged as a warning)
API_KEYS=
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=60

# ---- models ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
DEFAULT_RETRIEVAL_STRATEGY=dense

# ---- LLM providers: ordered fallback chain, any of: ollama, openai_compat, mock ----
LLM_PROVIDERS=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# OpenAI-compatible fallback (OpenAI, vLLM, LM Studio, Ollama's /v1 ...). Optional.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
# Time limits: one attempt, and ALL attempts of all providers for one answer. The total must stay below REQUEST_TIMEOUT_SECONDS (60), or a hung
# LLM yields 504s instead of the evidence-only fallback (found by the load test). With several providers keep LLM_TIMEOUT_SECONDS <= budget / providers.
LLM_TIMEOUT_SECONDS=45
LLM_TOTAL_BUDGET_SECONDS=30
# Reaching the model server (TCP connect) is bounded separately: a host that drops packets then fails in seconds, not after the whole budget.
LLM_CONNECT_TIMEOUT_SECONDS=5
# Concurrency: generations in flight per provider (a local Ollama serves one at a time, so 1; use the backend's real parallelism otherwise), and how long
# an answer waits for a free slot before the request degrades to the evidence-only answer. Measured in docs/performance.md.
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_WAIT_SECONDS=5
# Caches: evidence-only answers (0 = never), and the in-process LRU of evidence-text embeddings used by citation validation (0 = off).
CACHE_DEGRADED_TTL_SECONDS=30
EMBEDDING_UNIT_CACHE_SIZE=20000
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30

# ---- evaluation judge (optional, separate provider config) ----
JUDGE_PROVIDER=ollama
JUDGE_MODEL=qwen3:4b-instruct

# ---- tracing (OpenTelemetry; off by default, see docs/observability.md) ----
# none | otlp | console. `otlp` sends OTLP/HTTP to the endpoint below, for example the optional Jaeger:
#   docker compose --profile tracing up -d jaeger     (UI on http://127.0.0.1:16686)
OTEL_TRACES_EXPORTER=none
OTEL_SERVICE_NAME=resolveiq
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SAMPLE_RATIO=1.0

# Each process re-reads the taxonomy when another replica or the worker changed its version in Postgres (seconds; 0 = only at start-up).
TAXONOMY_SYNC_SECONDS=10

# --- drift monitoring (docs/drift.md) ---
# DRIFT_WINDOW_HOURS=24
# DRIFT_BASELINE_DAYS=14
# DRIFT_ALPHA=0.01                    # family-wise false-alarm budget per report
# DRIFT_ANALYSIS_HOURS=6              # worker schedule; 0 = only on demand
# DRIFT_TRIGGER_DISCOVERY=true        # an uncovered new-topic cluster enqueues a discovery run (proposals still need human review)

# --- LLM reproducibility and prompt budget (docs/architecture.md, docs/performance.md) ---
# LLM_TEMPERATURE=0.1
# LLM_DETERMINISTIC=false             # true: temperature 0 and a fixed seed (evaluation, replay); a request may also ask for it
# LLM_SEED=7
# LLM_NUM_CTX=4096                    # the context window configured on the model server; the prompt token budget is derived from it

# --- retrieval (docs/evaluation.md: the adaptive ladder is tuned, and on this corpus it matches dense) ---
# HNSW_EF_SEARCH=100                  # pgvector default is 40; see docs/database.md
# ADAPTIVE_MARGIN_TICKET=0.0          # 0 = the ticket search never escalates from dense
# ADAPTIVE_MARGIN_ARTICLE=0.0181

# --- API documentation (/docs, /redoc, /openapi.json) is hidden when APP_ENV=production unless this is true ---
# EXPOSE_API_DOCS=false
