# Production settings. Do NOT edit by hand for secrets: run `python deploy/gen_secrets.py --domain <your-domain>`,
# which copies this file to .env.prod with freshly generated passwords/keys. .env.prod is git-ignored.
SITE_ADDRESS=localhost            # public DNS name (automatic HTTPS) or `localhost` for a local trial
TLS_MODE=internal                 # `internal` = local CA (trials); real domain: your ACME contact email (Let's Encrypt)
HTTP_PORT=80
HTTPS_PORT=443
VERSION=1.0.0
BACKEND_REPLICAS=2

POSTGRES_DB=resolveiq
POSTGRES_USER=resolveiq_owner
POSTGRES_PASSWORD=__GENERATE__
APP_DB_USER=resolveiq_app
APP_DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
API_KEYS=__GENERATE__             # comma separated, >= 24 chars each; give agents / services their own key
METRICS_TOKEN=__GENERATE__
GRAFANA_ADMIN_PASSWORD=__GENERATE__

RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=60
PG_SHARED_BUFFERS=512MB

# LLM: bundled Ollama (--profile ollama) or an external server. Ordered fallback chain.
LLM_PROVIDERS=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b-instruct
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
